# Variables de entorno de Immich
# Documentación: https://docs.immich.app/install/environment-variables

# Carpeta donde se guardan las fotos/vídeos subidos (en el host)
UPLOAD_LOCATION=/data/immich

# Carpeta de datos de PostgreSQL (NO usar comparticiones de red)
DB_DATA_LOCATION=./postgres

# Versión a usar (p. ej. v2)
IMMICH_VERSION=v2

# Usuario / contraseña / base de datos de PostgreSQL -> poner credenciales propias
DB_USERNAME=<USUARIO_DB>
DB_PASSWORD=<CONTRASENA_DB_FUERTE>
DB_DATABASE_NAME=<NOMBRE_BD>
